{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winlator-build.local/schemas/game-profile.schema.json",
  "title": "Winlator Build Game Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "guestArchitecture", "graphics", "runtime"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "executables": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "guestArchitecture": {
      "type": "string",
      "enum": ["x86", "x86_64", "mixed", "unknown"]
    },
    "engine": { "type": ["string", "null"] },
    "graphics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directX"],
      "properties": {
        "directX": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["dx7", "dx8", "dx9", "dx10", "dx11", "dx12", "opengl", "vulkan", "unknown"]
          }
        },
        "preferredTranslationLayer": {
          "type": ["string", "null"],
          "enum": ["dxvk", "vkd3d", "wined3d", "d8vk", "native-opengl", "native-vulkan", null]
        },
        "fallbackOrder": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wineChannel": { "type": ["string", "null"] },
        "box64Preset": {
          "type": ["string", "null"],
          "enum": ["performance", "balanced", "compatibility", null]
        },
        "box86Required": { "type": "boolean" },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "deviceOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector"],
        "properties": {
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gpuFamily": { "type": "string" },
              "deviceId": { "type": "string" },
              "maxRamMiB": { "type": "integer", "minimum": 512 }
            }
          },
          "renderer": { "type": "string" },
          "translationLayer": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "knownIssues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["experimental", "testing", "stable"]
    }
  }
}
