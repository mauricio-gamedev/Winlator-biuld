{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winlator-build.local/schemas/component.schema.json",
  "title": "Winlator Build Component Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "type",
    "architectures",
    "source",
    "license",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "rootfs",
        "libc",
        "wine",
        "box64",
        "box86",
        "dxvk",
        "vkd3d",
        "wined3d",
        "renderer",
        "audio",
        "input",
        "utility",
        "compatibility"
      ]
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["arm64-v8a", "armeabi-v7a", "x86_64", "x86"]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "url"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "notice": { "type": "string" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAndroidApi": { "type": "integer", "minimum": 21 },
        "maxAndroidApi": { "type": ["integer", "null"], "minimum": 21 },
        "gpuFamilies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["adreno", "mali", "powervr", "xclipse", "generic"]
          }
        },
        "requiresVulkan": { "type": "boolean" },
        "requiresOpenGLES": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["planned", "experimental", "testing", "stable", "deprecated"]
    },
    "notes": { "type": "string" }
  }
}
